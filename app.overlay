&pinctrl {
	pinctrl_uart0: pinctrl_uart0 {
		group0 {
			pinmux = <PIN_P0_0__UART0_RX_A>;
			input-enable;
		};
		group1 {
			pinmux = <PIN_P0_1__UART0_TX_A>;
		};
	};
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_uart0>;
	pinctrl-names = "default";
	current-speed = <57600>;
};

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

